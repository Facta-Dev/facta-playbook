# Copy to .env and fill it in locally. .env is gitignored: never commit real
# values, tokens or keys here. Build-time variables only: an Android app
# cannot read this file at runtime, so anything the app needs becomes a
# BuildConfig field or a local.properties entry.

# Log level: trace | debug | info | warn | error
ANDROID_LOG_LEVEL=info

# Base URL of the backend API (no trailing slash)
ANDROID_API_BASE_URL=https://api.example.invalid

# Emulator system image API level used by the instrumented-test job
ANDROID_EMULATOR_API_LEVEL=37
