# Copy to .env and fill it in locally. .env is gitignored: never commit real
# values, tokens or keys here. Only non-secret settings belong in this file.

# Log level: trace | debug | info | warn | error
DESKTOP_LOG_LEVEL=info

# Base URL of the backend API (no trailing slash)
DESKTOP_API_BASE_URL=https://api.example.invalid

# Force CPU rendering and disable animations (same as --software-rendering)
DESKTOP_SOFTWARE_RENDERING=false
