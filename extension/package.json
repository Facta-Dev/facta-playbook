{
  "name": "<app>",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "<app> — Chrome extension (Manifest V3, TypeScript, React).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . && depcruise --config dependency-cruiser.config.cjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:platform": "vitest run --passWithNoTests tests/_platform",
    "evals": "node --test evals/contracts.test.mjs",
    "verify": "bash scripts/verify-template.sh",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^5.1.0"
  }
}
