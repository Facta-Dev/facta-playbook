# <app> backend — example environment.
# Copy to .env and fill in real values. NEVER commit the real .env
# (it is gitignored; only this .env.example with placeholders is versioned).
# After renaming <app> -> your project, replace the <APP>_ prefix with your
# project's uppercase prefix (e.g. MYAPP_DATABASE_URL).

# ── Runtime ──
<APP>_ENV=development
# Bind address for the HTTP listener (<app>-api).
<APP>_BIND=0.0.0.0:8080
# tracing/log filter: level[,target=level]. Examples: info,debug | sqlx=warn
<APP>_LOG_LEVEL=info
RUST_BACKTRACE=1

# ── Postgres ──
# Used by sqlx (runtime queries only — no compile-time DATABASE_URL needed)
# and the one-shot migrate subcommand.
<APP>_DATABASE_URL=postgres://<app>:<app>@localhost:5432/<app>
<APP>_DATABASE_MAX_CONNECTIONS=20
<APP>_DATABASE_MIN_CONNECTIONS=2

# ── Auth / security ──
# JWT signing secret — generate with: openssl rand -base64 32
# C2: the value below is a PLACEHOLDER that CANNOT pass the >=32-byte validator
# (it is < 32 chars). Replace it with 32+ random bytes before boot.
<APP>_JWT_SECRET=<set-me-to-32+-random-bytes>
# Argon2 pepper applied on top of the password hash. Rotate carefully.
# Optional (empty = disabled); if set, must be 32+ bytes and not a placeholder.
<APP>_PASSWORD_PEPPER=
# HMAC secret for signed API keys (<app>-sdk). 32+ random bytes.
# C2: same placeholder guard — replace before boot.
<APP>_APIKEY_HMAC_SECRET=<set-me-to-32+-random-bytes>

# ── OAuth sign-in (google / github) ──
# Google: One-Tap web client id. Empty = unconfigured (the endpoint answers 401).
# GOOGLE_ENABLED is a hard-off switch, default true.
<APP>_GOOGLE_CLIENT_ID=
<APP>_GOOGLE_ENABLED=true
# GitHub: OAuth app. Ships disabled — both routes answer 403 until
# GITHUB_ENABLED=true and both id + secret are set.
<APP>_GITHUB_CLIENT_ID=
<APP>_GITHUB_CLIENT_SECRET=
<APP>_GITHUB_ENABLED=false
# 302 target after a successful GitHub login/link.
<APP>_GITHUB_CALLBACK=http://localhost:3000/auth/callback
<APP>_FRONTEND_SUCCESS=http://localhost:3000/
# ── Observability (OpenTelemetry) ──
# Empty OTEL_EXPORTER_OTLP_ENDPOINT -> tracing-opentelemetry is NOT installed
# (offline-guarded; no socket opened). Set to a collector endpoint to export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=<app>-api
# Sampling ratio [0.0, 1.0]. 0 = no spans exported.
OTEL_TRACES_SAMPLER_ARG=0.1

# ── Feature flags ──
# Metrics plane: OFF by default. When ON, exposes GET /metrics (Prometheus).
<APP>_METRICS_ENABLED=false

# ── Offline guard (INV-T7) ──
# When true, AppState::from_env selects NoopMailer unconditionally —
# <APP>_MAILER_ENDPOINT is never read and no reqwest::Client (socket) is
# constructed. Use for smoke tests / dev without a mailer provider.
<APP>_OFFLINE=false

# ── SMTP (worker + api in-process outbox drain) ──
# Empty host => console sender (emails print to the log; email_jobs rows still
# move queued -> sent, so the outbox is testable offline). The api side keeps
# the legacy Mailer provider endpoint below for the provider transport.
<APP>_SMTP_HOST=
<APP>_SMTP_PORT=587
<APP>_SMTP_USER=
<APP>_SMTP_PASS=
<APP>_SMTP_FROM=no-reply@<app>.local

# ── Admin bootstrap whitelist ──
# Comma-separated, case-insensitive. Users on this list may POST
# /api/v1/auth/upgrade-to-admin unauthenticated to promote their own account
# before a verified admin exists (bootstrap-only; disable in production).
<APP>_ALLOWED_ADMIN_EMAILS=

# ── Realtime (WS) ──
# Same <APP>_JWT_SECRET verifies ?token= on /api/v1/ws; no extra config.

# Legacy transactional email provider endpoint (empty => SMTP/console path).
# Set to a real (or mock, in adapter tests) provider URL to select
# ProviderMailer. Ignored entirely when <APP>_OFFLINE=true.
<APP>_MAILER_ENDPOINT=