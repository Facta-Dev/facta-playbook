# Keep the build context small + reproducible.
target/
.env
.env.*
!.env.example
*.log
logs/
.git/
.gitignore
.github/
# .sqlx IS needed (offline compile) — do NOT ignore it.
credentials/
*.key
*.pem
# Local IDE / OS cruft.
.idea/
.vscode/
.DS_Store
# Generated spec (regenerated post-build; not needed in the image).
openapi.json
.openapi.generated.json