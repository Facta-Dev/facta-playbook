  "cards": [
    {
      "dot": "cyan",
      "title": "Crate workspace",
      "items": [
        "11 crates prefixed <app>-: core, ports, auth, adminusers, warden, mailer, loom, api, widgets, sdk, cli",
        "adapters live in ports/src/adapters/*_pg.rs with runtime-checked sqlx::query string SQL — no macros, no .sqlx cache, builds without a database"
      ]
    },
    {
      "dot": "emerald",
      "title": "Auth path",
      "items": [
        "warden owns the HS256 JWT codec with jti == sessions.id (revoking the session revokes the token), argon2id over an HMAC-SHA256 pepper pre-hash, cookies and the error envelope",
        "<app>-auth holds the signup/session/password/oauth use-cases behind ports repository traits"
      ]
    },
    {
      "dot": "rose",
      "title": "Background + realtime",
      "items": [
        "loom runs run_outbox_worker + run_janitor and the realtime hub (rooms user:<id>)",
        "mailer picks Console when <APP>_OFFLINE or the SMTP host is empty, else SmtpSender"
      ]
    }
  ]
