    {
      "id": "ledger",
      "lane": "ledger",
      "col": 5,
      "type": "database",
      "label": "audit_logs",
      "sublabel": "login · sessions"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "signup",
      "to": "issue",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "e2",
      "from": "issue",
      "to": "mailer",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "enqueue",
      "labelSegment": 1,
      "labelDy": 12
    },
    {
      "id": "e3",
      "from": "issue",
      "to": "checkv",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "e4",
      "from": "checkv",
      "to": "gates",
      "label": "codes checked",
      "labelAt": [
        365,
        407
      ]
    },
    {
      "id": "e5",
      "from": "gates",
      "to": "tokens",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "e6",
      "from": "tokens",
      "to": "sessions",
      "label": "rotate",
      "labelAt": [
        563,
        461
      ]
    },
    {
      "id": "e7",
      "from": "sessions",
      "to": "tokens",
      "route": "return-left",
      "fromSide": "left",
      "toSide": "left",
      "label": "replayed → CAS fail",
      "labelSegment": 1,
      "labelAt": [
        426,
        531
      ]
    },
    {
      "id": "e8",
      "from": "tokens",
      "to": "ledger",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "login · revoke",
      "labelSegment": 1,
      "labelDy": 12
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Codes never in JWTs",
      "items": [
        "6-digit codes are single-use, capped at 5 wrong guesses (MAX_CODE_ATTEMPTS), and expire in <APP>_VERIFY_CODE_TTL (24h); resets run <APP>_RESET_CODE_TTL (30m) with <APP>_RESET_RATE_LIMIT 3 per 5 min",
        "re-signup of an unverified email re-issues a code; verified email answers 409; /auth/validate-code lets the frontend pre-check a reset code",
        "password_resets auto-verify the account and <APP>_LOGOUT_ALL_ON_RESET revokes all sessions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gates",
      "items": [
        "password verifies first — one constant 401; after_failed_login counts into lockout at <APP>_MAX_LOGIN_RETRIES (5) → 403 account is blocked",
        "state gates run only after the password verifies (anti-enumeration): blocked → inactive → unverified, each a stable 403",
        "argon2id (Params::DEFAULT) over an HMAC-SHA256 pepper pre-hash (<APP>_PASSWORD_PEPPER), verified in constant time"
      ]
    },
    {
      "dot": "rose",
      "title": "Tokens",
      "items": [
        "access JWT HS256 15m with jti == sessions.id — revoking the session revokes the token",
        "refresh is a 64-char opaque token (48 random bytes) rotated in place; replay misses the CAS → 401"
      ]
    }
  ]
}
