      "toCol": 5
    }
  ],
  "mainPath": [
    "signup",
    "issue",
    "checkv",
    "gates",
    "tokens",
    "ledger"
  ],
  "nodes": [
    {
      "id": "signup",
      "lane": "client",
      "col": 0,
      "type": "frontend",
      "label": "Signup",
      "sublabel": "POST /auth/signup"
    },
    {
      "id": "issue",
      "lane": "codes",
      "col": 1,
      "type": "backend",
      "label": "Issue code",
      "sublabel": "6-digit · 24h · 5 tries"
    },
    {
      "id": "mailer",
      "lane": "mail",
      "col": 1,
      "type": "cloud",
      "label": "Mail",
      "sublabel": "email_jobs outbox",
      "width": 100
    },
    {
      "id": "checkv",
      "lane": "gates",
      "col": 2,
      "type": "backend",
      "label": "Verify",
      "sublabel": "POST /auth/verify"
    },
    {
      "id": "gates",
      "lane": "gates",
      "col": 3,
      "type": "security",
      "label": "Login gates",
      "sublabel": "5 tries · lockout"
    },
    {
      "id": "tokens",
      "lane": "tokens",
      "col": 4,
      "type": "backend",
      "label": "Mint tokens",
      "sublabel": "JWT 15m · refresh 720h"
    },
    {
      "id": "sessions",
      "lane": "tokens",
      "col": 5,
      "type": "database",
      "label": "sessions",
