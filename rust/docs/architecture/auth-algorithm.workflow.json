      "label": "Mail"
    }
  ],
  "phases": [
    {
      "id": "signup",
      "label": "Signup",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "check",
      "label": "Verify + gates",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
