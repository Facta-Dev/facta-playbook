  "cards": [
    {
      "dot": "cyan",
      "title": "Core state",
      "items": [
        "users holds role + provider ids (google_id · github_id); sessions hold the opaque 128-char refresh token with is_active + absolute expires_at",
        "codes live in email_verifications (6-digit · 5 tries · <APP>_VERIFY_CODE_TTL 24h) and password_resets (30m · <APP>_RESET_RATE_LIMIT 3 per 5 min)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Outbox",
      "items": [
        "auth use-cases INSERT email_jobs through the outbox on its own pool connection — not atomic with the state change, so a crash between them can lose the mail (ports/adapters/outbox_pg.rs)",
        "the claim CTE takes queued-due rows plus sending rows older than the 5-minute lease — FOR UPDATE SKIP LOCKED, at-least-once"
      ]
    },
    {
      "dot": "rose",
      "title": "Delivery + ledgers",
      "items": [
        "failures back off 2^n minutes with ±10% jitter (deterministic per job+attempt) and dead-letter to status failed at max_retries 3",
        "audit_logs records admin actions; the janitor (<APP>_JANITOR_POLL 1h) purges expired sessions and code rows"
      ]
    }
  ]
}
