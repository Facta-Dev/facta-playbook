# Copy to .env and fill it in locally. .env is gitignored: never commit real
# values, tokens or keys here. Build-time variables only: an iOS app cannot
# read this file at runtime, so anything the app needs becomes an xcconfig
# entry or a runtime configuration value.

# Log level: trace | debug | info | warn | error
IOS_LOG_LEVEL=info

# Base URL of the backend API (no trailing slash)
IOS_API_BASE_URL=https://api.example.invalid
