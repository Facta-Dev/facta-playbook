{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.development)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/credentials.json)",
      "Read(//**/credentials.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  }
}
