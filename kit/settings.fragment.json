{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro:cloud",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3-flash:cloud",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "minimax-m3.1-flash:cloud",
    "CLAUDE_CODE_SUBAGENT_MODEL": "minimax-m3.1-flash:cloud",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.development)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/credentials.json)",
      "Read(//**/credentials.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  }
}
