    {
      "dot": "cyan",
      "title": "Build",
      "items": [
        "single module: internal/features/* · platform/* · shared/* · gen/*",
        "go.mod pins requires; no go.sum committed — go mod tidy post-rename (INV-T3)",
        "one image, two entrypoints: cmd/api + cmd/worker"
      ]
    },
    {
      "dot": "emerald",
      "title": "Run",
      "items": [
        "<APP>_OFFLINE=true forces the console sender, no sockets (INV-T7)",
        "migrations via go tool goose — never at server startup",
        "readyz SELECT 1 through the pgx pool gates every deploy"
      ]
    },
    {
      "dot": "rose",
      "title": "Quality gates",
      "items": [
        "make ci = gofmt + vet + golangci-lint + gen-check + go test",
        "acceptance godog on the fake-wired mux; testcontainers for -tags=integration",
        "auth ships: bcrypt+pepper · JWT 15m · rotating refresh 720h · audit logs"
      ]
