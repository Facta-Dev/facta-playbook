  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-broker outbox",
      "items": [
        "the enqueue runs on its own pool connection after the state change — a dual-write window remains; delivery is at-least-once once the row exists",
        "claim = queued due now OR sending older than the 5-minute lease, FOR UPDATE SKIP LOCKED"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "render + send: templates from platform/email; Console when <APP>_OFFLINE or host empty, else SMTP PlainAuth STARTTLS",
        "batch 10 per tick (<APP>_OUTBOX_BATCH), poll every 2s (<APP>_OUTBOX_POLL)"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure + purge",
      "items": [
        "failure requeues with 2^n-minute backoff (±20% jitter) and dead-letters at max_retries 3",
        "the janitor sweeps expired sessions, email_verifications and password_resets hourly"
      ]
    }
  ]
