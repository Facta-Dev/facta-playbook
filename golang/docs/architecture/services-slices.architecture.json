  "cards": [
    {
      "dot": "cyan",
      "title": "Vertical slices",
      "items": [
        "internal/features/{authsignup, authsession, authpassword, authoauth, adminusers, widgets, realtime} each ship http.go · usecase.go · ports.go · postgres.go · queries.sql · domain.go · module.go",
        "everything is wired from the cmd/api/main.go composition root: config → pgxpool → slices → mux → server"
      ]
    },
    {
      "dot": "emerald",
      "title": "Platform + sqlc",
      "items": [
        "platform/authx mints HS256 JWTs and hashes bcrypt cost 10 with an optional pepper pre-hash",
        "sqlc generates pgx/v5 code into internal/gen/db from each slice's queries.sql (schema source = migrations/)"
      ]
    },
    {
      "dot": "rose",
      "title": "Realtime + email",
      "items": [
        "platform/realtime keeps in-process rooms user:<id> and publishes never-block, drop-on-full",
        "platform/email owns the email_jobs outbox queue (queue.go, deliberately sqlc-free) plus templates and Console/SMTP senders"
      ]
    }
  ]
