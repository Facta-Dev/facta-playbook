    {
      "dot": "cyan",
      "title": "Outbox enqueue (post-write)",
      "items": [
        "auth use-cases INSERT email_jobs on the outbox's own pool connection after the users/sessions writes (platform/email/queue.go) — a dual-write window remains",
        "the claim CTE takes queued-due-now rows plus sending rows older than the 5-minute lease"
      ]
    },
    {
      "dot": "emerald",
      "title": "Drain",
      "items": [
        "the worker polls every <APP>_OUTBOX_POLL (2s) with batch <APP>_OUTBOX_BATCH (10); cmd/api runs one in-process worker, cmd/worker a standalone drain",
        "SelectSender picks Console when <APP>_OFFLINE or the SMTP host is empty; otherwise net/smtp PlainAuth STARTTLS"
      ]
    },
    {
      "dot": "rose",
      "title": "Outcomes",
      "items": [
        "success lands sent with sent_at; failure backs off 2^n minutes with ±20% jitter up to max_retries 3",
        "dead-letters to status failed; the janitor purges expired sessions and code rows hourly"
      ]
    }
