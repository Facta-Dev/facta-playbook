# <app> environment — copy to .env and fill. NEVER commit .env.
# All vars carry the <APP>_ prefix (rename-substituted).

# --- runtime ---------------------------------------------------------------
<APP>_ENV=dev
<APP>_BIND=:8080
<APP>_LOG_LEVEL=info
# Postgres DSN (pgx). Local dev default points at docker-compose postgres.
<APP>_DATABASE_URL=postgres://postgres:postgres@localhost:5432/<app>?sslmode=disable
<APP>_DATABASE_MAX_CONNECTIONS=20

# --- auth (C2) -------------------------------------------------------------
# HS256 secret, 32+ bytes. The server REFUSES to start with the placeholder
# below or with a secret shorter than 32 bytes.
<APP>_JWT_SECRET=change-me-32-bytes-min-rotate-me
# Optional: bcrypt pre-hash pepper, 32+ bytes when set, empty = disabled.
# Set <APP>_PASSWORD_PEPPER BEFORE first user registration; rotating it invalidates all passwords.
<APP>_PASSWORD_PEPPER=
<APP>_ACCESS_TOKEN_TTL=15m
<APP>_REFRESH_TOKEN_TTL=720h
<APP>_VERIFY_CODE_TTL=24h
<APP>_RESET_CODE_TTL=30m
<APP>_MAX_LOGIN_RETRIES=5
<APP>_RESET_RATE_LIMIT=3
<APP>_RESET_RATE_WINDOW=5m
# true = also read the access token from cookie "<app>_access_token"
# (HttpOnly secure SameSite=strict); Authorization: Bearer stays primary.
<APP>_AUTH_COOKIE=false
# Reset password also revokes all sessions and re-verifies the account.
<APP>_LOGOUT_ALL_ON_RESET=true

# --- social sign-in (OAuth) -------------------------------------------------
# Google One Tap: the browser's ID token is verified RS256 against Google's
# JWKS (aud = <APP>_GOOGLE_CLIENT_ID). An empty client id = unconfigured —
# POST /api/v1/auth/google answers a 401 error envelope ("google not
# configured"). <APP>_GOOGLE_ENABLED is the hard-off switch when an id exists.
<APP>_GOOGLE_CLIENT_ID=
<APP>_GOOGLE_ENABLED=true
# GitHub (authorization-code flow). Disabled by default (reference parity): both
# github routes answer 403 AUTH_FORBIDDEN until enabled with id + secret.
<APP>_GITHUB_ENABLED=false
<APP>_GITHUB_CLIENT_ID=
<APP>_GITHUB_CLIENT_SECRET=
<APP>_AUTH_GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback
# Where the github callback leaves the browser with the token pair (#fragment)
# or its error (?error=…&error_description=…). Set to your SPA's callback page.
<APP>_AUTH_FRONTEND_SUCCESS=http://localhost:5173/auth/success
# INV-T7 note: both OAuth flows fetch real endpoints (Google JWKS, GitHub API)
# — while <APP>_OFFLINE=true they refuse with a config-style error instead of
# dialing out. SMTP's forbid-at-boot rule does not apply here; the refusal is
# at the request boundary.

# --- worker janitor ---------------------------------------------------------
# Purge interval for expired sessions and stale verification/reset codes
# (cmd/worker loop; idempotent, replica-safe). 1h keeps the tables lean —
# only already-expired rows are deleted, never rotation/audit history.
<APP>_JANITOR_POLL=1h

# --- bootstrap admin whitelist (reference upgrade_to_admin parity) ----------
# Unauthenticated POST /api/v1/auth/upgrade-to-admin: an email on this list may
# promote its own account to role+user_type ADMIN (case-insensitive, empty =
# disabled). Bootstrap-only — remove it once an admin exists in production.
#<APP>_ALLOWED_ADMIN_EMAILS=

# --- email outbox (INV-T7) -------------------------------------------------
# <APP>_OFFLINE=true forces the console sender and forbids real sockets:
# the template must boot with no credentials and no network.
<APP>_OFFLINE=true
<APP>_OUTBOX_POLL=2s
<APP>_OUTBOX_BATCH=10
<APP>_SMTP_HOST=
<APP>_SMTP_PORT=587
<APP>_SMTP_USER=
<APP>_SMTP_PASS=
<APP>_SMTP_FROM=no-reply@<app>.local

# INV-T7: with <APP>_OFFLINE=true leave every SMTP_* empty — config.Load
# rejects real SMTP credentials while offline. Emails print to the console
# and email_jobs rows still move queued -> sent, so the outbox is testable.
# Rotate = regenerate; never derive from hostnames or repo names.