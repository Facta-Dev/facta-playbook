# <app> environment — copy to .env and fill. NEVER commit .env.
# All vars carry the <APP>_ prefix (rename-substituted).
# List settings are JSON arrays, e.g. ["https://app.example.com"].

# --- runtime ---------------------------------------------------------------
<APP>_LOG_LEVEL=INFO
# Postgres DSN (SQLAlchemy async + asyncpg driver required).
<APP>_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/<app>
# JSON array of allowed browser origins; empty = no CORS middleware.
#<APP>_CORS_ORIGINS=["http://localhost:5173"]

# --- auth (C2) -------------------------------------------------------------
# HS256 secret, 32+ characters with at least 8 distinct characters. Replace
# this development value before any real deployment.
<APP>_JWT_SECRET=dev-compose-secret-32-bytes-min!
# JWT issuer claim and default API title.
#<APP>_JWT_ISSUER=<app>
# Optional argon2 pepper. Set BEFORE the first user registration; rotating it
# invalidates every stored password hash.
<APP>_PASSWORD_PEPPER=
<APP>_ACCESS_TTL_MINUTES=15
<APP>_REFRESH_TTL_HOURS=720
<APP>_VERIFY_CODE_TTL_HOURS=24
<APP>_VERIFY_MAX_ATTEMPTS=5
<APP>_RESET_TTL_MINUTES=30
<APP>_RESET_RATE_LIMIT=3

# --- social sign-in (OAuth) -------------------------------------------------
# Google: the browser's ID token is verified against Google's JWKS. An empty
# client id means unconfigured; POST /api/v1/auth/google answers a 503
# AUTH_OAUTH_FAILED envelope instead of dialing out while <APP>_OFFLINE=true.
<APP>_GOOGLE_CLIENT_ID=
# GitHub: authorization-code flow. An empty client id or secret means
# unconfigured; GET /api/v1/auth/github/login answers a 503 AUTH_OAUTH_FAILED
# envelope until both are set, and the callback redirects with an error query.
# While <APP>_OFFLINE=true the Google verifier and the GitHub code exchange
# answer 503 AUTH_OFFLINE before any socket; the GitHub authorize URLs answer
# 503 AUTH_OAUTH_FAILED (they build a URL, no dial).
<APP>_GITHUB_CLIENT_ID=
<APP>_GITHUB_CLIENT_SECRET=
<APP>_GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
# Where the GitHub callback leaves the browser with the token pair.
<APP>_FRONTEND_SUCCESS=http://localhost:5173/auth/success

# --- bootstrap admin whitelist ---------------------------------------------
# JSON array; an email on this list may promote its own account to ADMIN via
# POST /api/v1/auth/upgrade-to-admin. Empty = disabled. Bootstrap-only.
#<APP>_ALLOWED_ADMIN_EMAILS=["owner@example.com"]

# --- worker and outbox (INV-T7) --------------------------------------------
# <APP>_OFFLINE=true forces the console sender and refuses real OAuth sockets:
# the template must boot with no credentials and no network.
<APP>_OFFLINE=true
<APP>_OUTBOX_POLL_SECONDS=2
<APP>_OUTBOX_BATCH=10
<APP>_JANITOR_POLL_SECONDS=3600
<APP>_SMTP_HOST=
<APP>_SMTP_PORT=587
<APP>_SMTP_USER=
<APP>_SMTP_PASSWORD=
<APP>_MAIL_FROM=no-reply@<app>.local

# INV-T7: with <APP>_OFFLINE=true leave every SMTP_* value empty — Settings
# rejects real SMTP credentials while offline. Emails print to the console and
# email_jobs rows still move queued -> sent, so the outbox is testable.
