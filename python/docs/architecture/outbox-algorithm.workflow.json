  "cards": [
    {
      "dot": "cyan",
      "title": "Outbox enqueue (atomic)",
      "items": [
        "enqueue_email(session, message, now) only stages the INSERT on the caller's AsyncSession; the slice adapter commits the business write and the job together, so no dual-write window exists (platform/email/outbox.py)",
        "the claim CTE takes queued-due-now rows plus sending rows older than the 5-minute lease"
      ]
    },
    {
      "dot": "emerald",
      "title": "Drain",
      "items": [
        "the worker polls every <APP>_OUTBOX_POLL_SECONDS (2s) with batch <APP>_OUTBOX_BATCH (10); python -m app.bin.worker runs the standalone drain",
        "select_sender picks Console when <APP>_OFFLINE or the SMTP host is empty; otherwise the STARTTLS SMTP sender"
      ]
    },
    {
      "dot": "rose",
      "title": "Outcomes",
      "items": [
        "success lands sent with sent_at; failure backs off 2^n minutes (no jitter) up to the row's max_retries (3)",
        "dead-letters to status failed; the janitor purges expired sessions and code rows hourly"
      ]
    }
  ]
