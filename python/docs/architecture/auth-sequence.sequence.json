  "cards": [
    {
      "dot": "cyan",
      "title": "Signup flow",
      "items": [
        "signup writes the user, the email_verifications row and the email_jobs job on one AsyncSession and commits once — the outbox enqueue is atomic with the business write",
        "the worker claims with FOR UPDATE SKIP LOCKED; a 5-minute sending lease recovers crashed workers"
      ]
    },
    {
      "dot": "emerald",
      "title": "Code lifecycle",
      "items": [
        "codes expire in 24h, cap at 5 wrong guesses and are consumed on verify",
        "resend never reveals whether the account exists; verified email answers 409"
      ]
    },
    {
      "dot": "rose",
      "title": "Login + tokens",
      "items": [
        "password first — one constant 401; then blocked → inactive → unverified, each a stable 403",
        "access JWT 15m; refresh is a 128-hex-char opaque token rotated in place (replay misses the CAS → 401)"
      ]
    }
  ]
