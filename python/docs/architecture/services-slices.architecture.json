    {
      "dot": "cyan",
      "title": "Vertical slices",
      "items": [
        "src/app/features/{authsignup, authsession, authpassword, authoauth, adminusers, widgets} each ship domain.py · ports.py · usecase.py · queries.py · postgres.py · http.py · module.py; the realtime slice ships only module.py — its hub lives in platform/realtime",
        "everything is wired from the src/app/bin/api.py composition root: Settings → engine → slices → FastAPI → uvicorn"
      ]
    },
    {
      "dot": "emerald",
      "title": "Platform + typed queries",
      "items": [
        "platform/authx mints HS256 JWTs and hashes argon2id with an optional concatenated pepper",
        "each slice hand-writes parameterized text() queries over SQLAlchemy (schema source = migrations/)"
      ]
    },
    {
      "dot": "rose",
      "title": "Realtime + email",
      "items": [
        "platform/realtime keeps in-process rooms user:<id> and publishes never-block, drop-on-full",
        "platform/email owns the email_jobs outbox (outbox.py: stage + claim + settle) plus templates and the console/SMTP select_sender"
      ]
    }
  ]
