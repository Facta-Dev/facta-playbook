{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "backend-python Runtime Lifecycle",
    "output": "runtime-lifecycle.lifecycle.html",
    "animation": "trace",
    "quality_profile": "showcase"
  },
  "mainPath": ["boot", "wire", "serve", "ready", "flow"],
  "states": [
    {
      "id": "boot",
      "type": "start",
      "label": "Settings()",
      "sublabel": "typed env",
      "step": "01",
      "tag": "entry"
    },
    {
      "id": "wire",
      "type": "active",
      "label": "wire deps",
      "sublabel": "engine · slices · FastAPI",
      "step": "02"
    },
    {
      "id": "serve",
      "type": "active",
      "label": "http serve",
      "sublabel": "uvicorn :8000",
      "step": "03"
    },
    {
      "id": "ready",
      "type": "decision",
      "label": "readyz gate",
      "sublabel": "SELECT 1 + alembic_version",
      "step": "04",
      "tag": "gate"
    },
    {
      "id": "flow",
      "type": "success",
      "label": "Request flow",
      "sublabel": "slices · JSON envelope",
      "step": "05",
      "tag": "done"
    },
    {
      "id": "authfail",
      "type": "waiting",
      "label": "401 / 403 gate",
      "sublabel": "require_auth · require_role",
      "tag": "pause"
    },
    {
      "id": "drain",
      "type": "active",
      "label": "Drain loop",
      "sublabel": "claim CTE · 2^n",
      "tag": "automatic"
    },
    {
      "id": "mfail",
      "type": "failure",
      "label": "Exit 1",
      "sublabel": "config · dial fail-closed",
      "tag": "terminal"
    },
    {
      "id": "degraded",
      "type": "failure",
      "label": "503 readyz",
      "sublabel": "DB unreachable",
      "tag": "terminal"
    },
    {
      "id": "recovered",
      "type": "success",
      "label": "Sent / Recovered",
      "sublabel": "mark sent · janitor 1h",
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "t-boot-wire",
      "from": "boot",
      "to": "wire"
    },
    {
      "id": "t-wire-serve",
      "from": "wire",
      "to": "serve"
    },
    {
      "id": "t-serve-ready",
      "from": "serve",
      "to": "ready"
    },
    {
      "id": "t-ready-flow",
      "from": "ready",
      "to": "flow"
    },
    {
      "from": "serve",
      "to": "authfail",
      "variant": "security"
    },
    {
      "from": "ready",
      "to": "degraded",
      "variant": "dashed",
      "label": "DB down"
    },
    {
      "from": "flow",
      "to": "drain",
      "variant": "security"
    },
    {
      "from": "drain",
      "to": "recovered",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Boot rail",
      "items": [
        "python -m app.bin.api never migrates — replicas would race; the compose migrations service is the one-shot alembic CLI runner",
        "revisions are numbered files each exporting upgrade() and downgrade(); the API boots Settings → engine → slices → FastAPI"
      ]
    },
    {
      "dot": "emerald",
      "title": "Gates + recovery",
      "items": [
        "require_auth answers 401 envelopes, require_role answers 403 insufficient role; the middleware (request-id, security headers, CORS) wraps every route, /healthz and /readyz included",
        "the worker claims with FOR UPDATE SKIP LOCKED (5-minute lease), polling <APP>_OUTBOX_POLL_SECONDS 2s with batch <APP>_OUTBOX_BATCH 10"
      ]
    },
    {
      "dot": "rose",
      "title": "Explicit endings",
      "items": [
        "readyz runs SELECT 1 and reads alembic_version, answering a 503 envelope when it fails",
        "WS auth runs before the handshake completes — a bad ?token= accepts the socket and closes 4001 authentication_failed, so the browser sees the code and not an HTTP 403; SIGINT/SIGTERM set the worker's stop event and cancel its tasks"
      ]
    }
  ]
}
