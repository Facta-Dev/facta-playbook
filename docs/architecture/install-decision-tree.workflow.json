  "cards": [
    {
      "dot": "cyan",
      "title": "Preflight",
      "items": [
        "git · python3 ≥ 3.9 · claude ≥ 2.1.251 · gh auth",
        "native Windows is not supported directly: use WSL2 first and re-run the bootstrap inside it",
        "the provider branch changes only which settings env lands in ~/.claude/settings.json"
      ]
    },
    {
      "dot": "amber",
      "title": "Provider paths",
      "items": [
        "OLLAMA: tier aliases (opus / sonnet / haiku → Ollama cloud models), endpoint, literal token `ollama`, cheap subagent routing; verify with the §9 probes",
        "ANTHROPIC: no endpoint pinning; `model: sonnet` still applies; native `--advisor` is available (runbook §7)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Scope: the same shell steps",
      "items": [
        "user kit: install-user-kit.sh [--provider=ollama|anthropic|auto]",
        "kit check: kit_check.py (0 errors required)",
        "working set: clone-repos.sh --group=selected --dir ~/work",
        "skill packs: install-skill-packs.sh --dir ~/work",
        "cost tracker: ~/work/claude-code-cli-cost-tracker/install.sh",
        "each repo: configure-repo.sh <repo> --kit=<golang|nodejs|python|rust|java|extension|desktop|frontend-mobile|mobile-android|mobile-ios>"
      ]
    },
    {
      "dot": "rose",
      "title": "Verify",
      "items": [
        "kit_check.py",
        "deny probe (PLAYBOOK_INSTALL §5)",
        "routing probes (§9)",
        "/context and /doctor"
      ]
    }
  ]
