# <app> — build-time environment.
#
# Copy to .env.local and uncomment what you need. Expo inlines ONLY the
# EXPO_PUBLIC_-prefixed names into the bundle.
#
# Never put a secret here: the bundle ships inside the app binary, and
# anything prefixed EXPO_PUBLIC_ is readable by anyone with the app.
# Secrets live behind the API (PKCE, no client secret).
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
