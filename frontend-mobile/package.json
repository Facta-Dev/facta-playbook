{
  "name": "<app>",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "<app> — React Native + Expo mobile app (TypeScript, hexagonal + MVVM).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:platform": "vitest run tests/_platform",
    "export:android": "pnpm --filter app exec expo export --platform android",
    "evals": "node --test evals/contracts.test.mjs",
    "verify": "bash scripts/verify-template.sh",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run export:android"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "~5.1.0"
  }
}
